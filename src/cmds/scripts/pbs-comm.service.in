[Unit]
Description=OpenPBS communication daemon
Documentation=man:pbs_comm(8)
Requires=pbs-prepare.service
After=pbs-prepare.service network-online.target
PartOf=pbs.target

[Service]
Type=forking
ExecCondition=@prefix@/libexec/pbs-systemd-helper enabled comm
ExecStart=/bin/sh -c '. ${PBS_CONF_FILE:-/etc/pbs.conf}; exec "$PBS_EXEC/sbin/pbs_comm"'
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=180s
KillSignal=SIGTERM

[Install]
WantedBy=pbs.target
