[Unit]
Description=OpenPBS server daemon
Documentation=man:pbs_server(8)
Requires=pbs-dataservice.service
Wants=pbs-comm.service
After=pbs-dataservice.service
PartOf=pbs.target

[Service]
Type=forking
ExecCondition=/usr/libexec/pbs-systemd-helper enabled server
ExecStart=/usr/libexec/pbs-systemd-helper start-server
ExecStop=/usr/libexec/pbs-systemd-helper stop-server
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180s
TimeoutStopSec=180s
KillSignal=SIGTERM

[Install]
WantedBy=pbs.target
