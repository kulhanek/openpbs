[Unit]
Description=OpenPBS scheduler daemon
Documentation=man:pbs_sched(8)
Requires=pbs-prepare.service
Wants=pbs-comm.service pbs-server.service
After=pbs-prepare.service pbs-comm.service pbs-server.service network-online.target
PartOf=pbs.target

[Service]
Type=forking
ExecCondition=@prefix@/libexec/pbs-systemd-helper enabled sched
ExecStart=@prefix@/libexec/pbs-systemd-helper start-sched
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=180s
KillSignal=SIGTERM

