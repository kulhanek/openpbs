#!/bin/sh
#
# OpenPBS data service controller with native systemd support.
#
# The traditional start/stop/status interface is retained for non-systemd
# callers.  The systemd-* commands are private entry points used by the
# pbs-dataservice.service unit and deliberately do NOT call
# pbs_dataservice.bin -s start, because that path uses su(1), pg_ctl(1), and
# pbs_ds_systemd to move processes between cgroups.

set -u

. "${PBS_CONF_FILE:-/etc/pbs.conf}"

PBS_TMPDIR="${PBS_TMPDIR:-${TMPDIR:-/var/tmp}}"
export PBS_TMPDIR

version_mismatch=3
CWD=$(pwd)

data_srv_bin="${PBS_EXEC}/sbin/pbs_dataservice.bin"
data_srv_mon="${PBS_EXEC}/sbin/pbs_ds_monitor"

get_db_user()
{
    dbusr_file="${PBS_HOME}/server_priv/db_user"
    if [ -f "${dbusr_file}" ]; then
        cat "${dbusr_file}"
    else
        echo "pbsdata"
    fi
}

get_port()
{
    if [ "${1:-}" ]; then
        PBS_DATA_SERVICE_PORT=$1
    elif [ -z "${PBS_DATA_SERVICE_PORT:-}" ]; then
        PBS_DATA_SERVICE_PORT=$(awk '
            $1 == "pbs_dataservice" {
                split($2, a, "/");
                if (a[2] == "tcp") port = a[1]
            }
            END { if (port != "") print port }
        ' /etc/services 2>/dev/null)
    fi

    PBS_DATA_SERVICE_PORT="${PBS_DATA_SERVICE_PORT:-15007}"
    export PBS_DATA_SERVICE_PORT
    DBPORT=${PBS_DATA_SERVICE_PORT}
    export DBPORT
}

get_port "${3:-}"

set +u
# Locate the PostgreSQL installation selected when OpenPBS was built.
. "${PBS_EXEC}/libexec/pbs_db_env"
set -u

DBUSER=$(get_db_user) || {
    echo "Could not retrieve PBS Data Service User" >&2
    exit 1
}
export DBUSER

validate_common()
{
    if [ ! -d "${PBS_HOME}/datastore" ]; then
        echo "PBS Data Service datastore ${PBS_HOME}/datastore does not exist" >&2
        return 1
    fi

    if [ -z "$(ls -A "${PBS_HOME}/datastore" 2>/dev/null)" ]; then
        echo "PBS Data Service not initialized" >&2
        return 1
    fi

    if ! id "${DBUSER}" >/dev/null 2>&1; then
        echo "User ${DBUSER} does not exist" >&2
        return 1
    fi

    dbuid=$(id -u "${DBUSER}") || return 1
    if [ "${dbuid}" -eq 0 ]; then
        echo "PBS Data Service User should not be root" >&2
        return 1
    fi

    owner=$(stat -c '%U' "${PBS_HOME}/datastore" 2>/dev/null) || {
        echo "Cannot stat ${PBS_HOME}/datastore" >&2
        return 1
    }
    if [ "${owner}" != "${DBUSER}" ]; then
        echo "PBS datastore owner is ${owner}, but configured Data Service user is ${DBUSER}" >&2
        return 1
    fi

    return 0
}

require_root()
{
    if [ "$(id -u)" -ne 0 ]; then
        echo "Please run as root" >&2
        exit 1
    fi
}

# Execute PostgreSQL as DBUSER without su/login/PAM.  This is the critical
# difference from the legacy implementation: the process never leaves the
# systemd service cgroup.  setpriv(1) execs the target after dropping IDs.
exec_postgres_as_dbuser()
{
    setpriv_bin=$(command -v setpriv 2>/dev/null || true)
    if [ -z "${setpriv_bin}" ]; then
        echo "setpriv is required for native systemd data-service startup" >&2
        exit 1
    fi

    postgres="${PGSQL_BIN}/postgres"
    if [ ! -x "${postgres}" ]; then
        echo "PostgreSQL server binary not found: ${postgres}" >&2
        exit 1
    fi

    cd "${PBS_HOME}/datastore" || exit 1

    # PGSQL_LIBSTR is generated by pbs_db_env and, on installations that need
    # it, contains the environment prefix required for PostgreSQL libraries.
    if [ -n "${PGSQL_LIBSTR:-}" ]; then
        exec "${setpriv_bin}" \
            --reuid="${DBUSER}" \
            --regid="${DBUSER}" \
            --init-groups \
            /bin/sh -c "${PGSQL_LIBSTR} exec \"\$@\"" sh \
            "${postgres}" -D "${PBS_HOME}/datastore" -p "${DBPORT}"
    else
        exec "${setpriv_bin}" \
            --reuid="${DBUSER}" \
            --regid="${DBUSER}" \
            --init-groups \
            "${postgres}" -D "${PBS_HOME}/datastore" -p "${DBPORT}"
    fi
}

start_monitor()
{
    # pbs_ds_monitor intentionally forks/setsid itself.  This is harmless
    # here: it is launched by this systemd service, performs no PAM/systemd
    # session transition, and therefore remains in the service cgroup.
    "${data_srv_mon}" monitor
}

wait_ready()
{
    timeout=${PBS_DS_START_TIMEOUT:-60}
    i=0

    if [ -x "${PGSQL_BIN}/pg_isready" ]; then
        while [ "${i}" -lt "${timeout}" ]; do
            if "${PGSQL_BIN}/pg_isready" -q -p "${DBPORT}" >/dev/null 2>&1; then
                return 0
            fi
            i=$((i + 1))
            sleep 1
        done
        echo "PBS Data Service did not become ready on port ${DBPORT} within ${timeout}s" >&2
        return 1
    fi

    # Fallback for PostgreSQL installations without pg_isready.
    while [ "${i}" -lt "${timeout}" ]; do
        if [ -r "${PBS_HOME}/datastore/postmaster.pid" ]; then
            pid=$(sed -n '1p' "${PBS_HOME}/datastore/postmaster.pid")
            if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
                return 0
            fi
        fi
        i=$((i + 1))
        sleep 1
    done

    echo "PBS Data Service did not create a live postmaster within ${timeout}s" >&2
    return 1
}

check_status()
{
    cd "${PBS_HOME}/datastore" || {
        echo "Could not change directory to ${PBS_HOME}/datastore" >&2
        return 255
    }

    res=$(${data_srv_bin} -s status 2>&1)
    status=$?

    if [ "${status}" -eq 0 ]; then
        if printf '%s\n' "${res}" | grep -q 'no server running'; then
            status=1
            msg="PBS data service not running"
        else
            msg="PBS data service running locally"
        fi
    else
        status=1
        msg="PBS data service not running"
        out=$(${data_srv_mon} check 2>&1)
        if [ $? -ne 0 ]; then
            status=2
            msg=${out}
        fi
    fi

    cd "${CWD}" || true
    export msg
    return "${status}"
}

case "${1:-}" in
    systemd-start)
        require_root
        validate_common || exit 1

        # Acquire the PBS datastore lock before PostgreSQL starts, matching
        # the ordering of the legacy pbs_start_db() implementation.
        if ! start_monitor; then
            echo "Failed to start PBS Data Service monitor" >&2
            exit 1
        fi

        # Stay in the foreground.  systemd now owns the actual postmaster PID.
        exec_postgres_as_dbuser
        ;;

    systemd-wait)
        require_root
        validate_common || exit 1
        wait_ready
        exit $?
        ;;

    start)
        # Legacy/non-systemd compatibility path.
        require_root
        validate_common || exit 1
        check_status
        ret=$?
        if [ "${ret}" -eq 1 ]; then
            echo "Starting PBS Data Service.."
            "${data_srv_bin}" -s start
            ret=$?
            if [ "${ret}" -ne 0 ]; then
                echo "Failed to start PBS Data Service"
                if [ "${ret}" -eq "${version_mismatch}" ]; then
                    echo "PBS database needs to be upgraded."
                    echo "Consult the documentation/release notes for details."
                fi
            fi
        else
            echo "${msg} - cannot start"
        fi
        exit "${ret}"
        ;;

    stop)
        # Legacy/non-systemd compatibility path.  Native systemd shutdown does
        # not use this branch; systemd signals PostgreSQL only after pbs-server
        # has stopped, according to unit ordering.
        require_root
        check_status
        ret=$?
        if [ "${ret}" -ne 0 ]; then
            echo "${msg} - cannot stop"
            exit 0
        fi

        "${PBS_EXEC}/bin/qstat" -Bf >/dev/null 2>&1
        if [ $? -eq 0 ]; then
            echo "PBS server is running. Cannot stop PBS Data Service now."
            exit 1
        fi

        echo "Stopping PBS Data Service.."
        cd "${PBS_HOME}/datastore" || exit 1
        "${data_srv_bin}" -s stop
        ret=$?
        cd "${CWD}" || true
        exit "${ret}"
        ;;

    status)
        check_status
        ret=$?
        echo "${msg}"
        exit "${ret}"
        ;;

    *)
        echo "Usage: $(basename "$0") {start|stop|status}" >&2
        exit 1
        ;;
esac
