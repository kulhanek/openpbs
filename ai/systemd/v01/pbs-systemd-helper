#!/bin/bash
set -u

conf=${PBS_CONF_FILE:-/etc/pbs.conf}
if [[ ! -r "$conf" ]]; then
    echo "PBS configuration is not readable: $conf" >&2
    exit 1
fi
# shellcheck disable=SC1090
. "$conf"

: "${PBS_EXEC:?PBS_EXEC is undefined in $conf}"
: "${PBS_HOME:?PBS_HOME is undefined in $conf}"
PBS_MOM_HOME=${PBS_MOM_HOME:-$PBS_HOME}
pbslibdir="$PBS_EXEC/lib"
[[ -d "$pbslibdir" ]] || pbslibdir="$PBS_EXEC/lib64"

lc_host_name() {
    printf '%s\n' "$1" | cut -d, -f1 | cut -d: -f1 | cut -d. -f1 | tr '[:upper:]' '[:lower:]'
}

check_hostname() {
    getent hosts "$1" >/dev/null 2>&1 || host "$1" >/dev/null 2>&1
}

get_server_hostname() {
    local shn
    if [[ -z "${PBS_PRIMARY:-}" || -z "${PBS_SECONDARY:-}" ]]; then
        shn=${PBS_SERVER_HOST_NAME:-${PBS_SERVER:-}}
    else
        shn=$PBS_PRIMARY
    fi
    lc_host_name "$shn"
}

check_core() {
    local dir=$1 file max=0 seq
    [[ -d "$dir" ]] || return 0
    shopt -s nullglob
    for file in "$dir"/core_*; do
        seq=${file##*_}
        [[ $seq =~ ^[0-9]+$ ]] && (( 10#$seq > max )) && max=$((10#$seq))
    done
    for file in "$dir"/core "$dir"/core.[0-9]*; do
        [[ -e "$file" ]] || continue
        ((max++))
        mv -- "$file" "$dir/core_$(printf '%04d' "$max")"
        echo "Renamed stale core file $file" >&2
    done
    shopt -u nullglob
}

check_maxsys() {
    local cfg="$PBS_MOM_HOME/mom_priv/config" val
    [[ -f "$cfg" ]] || return 0
    grep -q '^\$restrict_user_maxsysid' "$cfg" && return 0
    [[ -f /etc/login.defs ]] || return 0
    val=$(awk '$1 == "SYSTEM_UID_MAX" {print $2; exit}' /etc/login.defs)
    [[ -n "$val" ]] || val=$(awk '$1 == "UID_MIN" {print $2-1; exit}' /etc/login.defs)
    [[ -n "$val" ]] && printf '$restrict_user_maxsysid %s\n' "$val" >> "$cfg"
}

is_secondary_host() {
    local me sec
    [[ -n "${PBS_SECONDARY:-}" ]] || return 1
    me=$(lc_host_name "${PBS_LEAF_NAME:-$(hostname)}")
    sec=$(lc_host_name "$PBS_SECONDARY")
    [[ "$me" == "$sec" ]]
}

enabled_component() {
    local var value
    case "$1" in
        server) var=PBS_START_SERVER ;;
        mom)    var=PBS_START_MOM ;;
        sched)  var=PBS_START_SCHED ;;
        comm)   var=PBS_START_COMM ;;
        *) echo "Unknown component: $1" >&2; return 2 ;;
    esac
    value=${!var:-0}
    [[ "$value" =~ ^[0-9]+$ ]] && (( value > 0 ))
}

prepare() {
    local server_hostname needmakehome=0 qstatver homever

    [[ -d "$PBS_EXEC" ]] || { echo "PBS_EXEC does not exist: $PBS_EXEC" >&2; return 1; }

    server_hostname=$(get_server_hostname)
    if [[ -z "$server_hostname" || "$server_hostname" == CHANGE_THIS_TO_PBS_SERVER_HOSTNAME ]]; then
        echo "Invalid PBS server hostname in $conf" >&2
        return 1
    fi
    check_hostname "$server_hostname" || {
        echo "PBS server hostname does not resolve: $server_hostname" >&2
        return 1
    }

    [[ -d "$PBS_HOME" ]] || needmakehome=1
    if (( needmakehome == 0 )) && [[ ! -f "$PBS_HOME/pbs_version" ]]; then
        needmakehome=2
    elif (( needmakehome == 0 )); then
        qstatver=$($PBS_EXEC/bin/qstat --version | sed -e 's/^.* = //')
        homever=$(cat "$PBS_HOME/pbs_version")
        [[ "$qstatver" == "$homever" ]] || needmakehome=3
    fi
    if (( needmakehome == 0 )) && enabled_component server && [[ ! -d "$PBS_HOME/datastore" ]]; then
        needmakehome=4
    fi

    if (( needmakehome != 0 )); then
        [[ -x "$PBS_EXEC/libexec/pbs_habitat" ]] || {
            echo "$PBS_EXEC/libexec/pbs_habitat is missing" >&2
            return 1
        }
        "$PBS_EXEC/libexec/pbs_habitat" || return 1
    fi

    check_core "$PBS_HOME/server_priv"
    check_core "$PBS_HOME/sched_priv"
    check_core "$PBS_MOM_HOME/mom_priv"

    if enabled_component mom; then
        check_maxsys
    fi
}

start_server() {
    local rc
    if [[ -f "$pbslibdir/init.d/limits.pbs_server" ]]; then
        # shellcheck disable=SC1090
        . "$pbslibdir/init.d/limits.pbs_server"
    fi
    "$PBS_EXEC/sbin/pbs_server"
    rc=$?
    if (( rc == 4 )); then
        echo "pbs_server returned 4; retrying once after 30 seconds" >&2
        sleep 30
        "$PBS_EXEC/sbin/pbs_server"
        return $?
    fi
    return "$rc"
}

start_mom() {
    if [[ -f "$pbslibdir/init.d/limits.pbs_mom" ]]; then
        # shellcheck disable=SC1090
        . "$pbslibdir/init.d/limits.pbs_mom"
    fi
    exec "$PBS_EXEC/sbin/pbs_mom" -p
}

start_sched() {
    if [[ -f "$pbslibdir/init.d/limits.pbs_sched" ]]; then
        # shellcheck disable=SC1090
        . "$pbslibdir/init.d/limits.pbs_sched"
    fi
    exec "$PBS_EXEC/sbin/pbs_sched"
}

stop_server() {
    local pidfile pid active_server me
    if is_secondary_host; then
        pidfile="$PBS_HOME/server_priv/server.lock.secondary"
    else
        pidfile="$PBS_HOME/server_priv/server.lock"
    fi
    pid=$(cat "$pidfile" 2>/dev/null || true)
    [[ "$pid" =~ ^[0-9]+$ ]] || return 0
    kill -0 "$pid" 2>/dev/null || return 0

    active_server=$($PBS_EXEC/bin/qstat -Bf 2>/dev/null | awk -F' = ' '/server_host = / {print $2; exit}')
    active_server=$(lc_host_name "${active_server:-}")
    me=$(lc_host_name "${PBS_LEAF_NAME:-$(hostname)}")

    if [[ -n "$active_server" && "$me" == "$active_server" ]]; then
        if [[ -r "$PBS_HOME/server_priv/qmgr_shutdown" ]]; then
            "$PBS_EXEC/bin/qmgr" < "$PBS_HOME/server_priv/qmgr_shutdown" || true
        fi
        "$PBS_EXEC/bin/qterm" -t quick || kill -TERM "$pid"
    else
        kill -TERM "$pid"
    fi
}

case "${1:-}" in
    enabled)      enabled_component "${2:?component required}" ;;
    prepare)      prepare ;;
    start-server) start_server ;;
    start-mom)    start_mom ;;
    start-sched)  start_sched ;;
    stop-server)  stop_server ;;
    *)
        echo "Usage: $0 {enabled COMPONENT|prepare|start-server|start-mom|start-sched|stop-server}" >&2
        exit 2
        ;;
esac
