[Unit]
Description=OpenPBS server daemon
Documentation=man:pbs_server(8)
Requires=pbs-dataservice.service pbs-server-init.service
Wants=pbs-comm.service
After=pbs-dataservice.service pbs-server-init.service pbs-comm.service network-online.target
PartOf=pbs.target

[Service]
Type=forking
ExecCondition=@prefix@/libexec/pbs-systemd-helper enabled server
ExecStart=@prefix@/libexec/pbs-systemd-helper start-server
ExecStop=@prefix@/libexec/pbs-systemd-helper stop-server
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180s
TimeoutStopSec=180s
KillSignal=SIGTERM

